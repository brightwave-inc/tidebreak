# Rust build artifacts
/target/
**/target/
**/*.rs.bk

# Environment & secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
secrets.toml
credentials.json

# Node / frontend (desktop UI)
node_modules/
dist/
.vite/

# Tauri codegen (regenerated on build)
crates/openwave-desktop/gen/
crates/openwave-desktop/binaries/openwave-host-broker-*

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Default `openwave serve` data dir when OPENWAVE_DATA_DIR is unset (SQLite +
# vector index); created wherever the server is launched from.
.openwave/
