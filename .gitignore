# Rust build artifacts
/target/
**/target/
**/*.rs.bk

# Environment & secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
secrets.toml
credentials.json

# Node / frontend (desktop UI and mobile)
node_modules/
dist/
storybook-static/
.vite/
.vercel/
.expo/
mobile/.expo/

# Python helper bytecode
__pycache__/
*.py[cod]

# Tauri codegen (regenerated on build)
crates/tidebreak-desktop/gen/
crates/tidebreak-desktop/binaries/tidebreak-host-broker-*
crates/tidebreak-desktop/binaries/tidebreak-*
crates/tidebreak-desktop/resources/host-broker/tidebreak-cu-helper

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# A CLI profile kept in the repo with TIDEBREAK_DATA_DIR=.tidebreak (SQLite +
# vector index). Earlier CLI builds created it wherever a command ran; now it
# exists only when TIDEBREAK_DATA_DIR names it.
.tidebreak/
.vercel/
.env.local
.env.*.local

# TypeScript incremental build info
*.tsbuildinfo
