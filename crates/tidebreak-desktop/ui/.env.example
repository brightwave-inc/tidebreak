# Optional. A browser tab on the Vite origin attaches to the running desktop
# automatically via `{data_dir}/listen.json` while `scripts/dev.sh` is up.
# Set these only to point the same UI at a separate `tidebreak serve`.
#
#   cargo run -p tidebreak-cli -- serve
#   # note the printed URL + token, then:
#   pnpm --dir crates/tidebreak-desktop/ui dev
#
VITE_TIDEBREAK_URL=http://127.0.0.1:PORT
VITE_TIDEBREAK_TOKEN=paste-token-here
