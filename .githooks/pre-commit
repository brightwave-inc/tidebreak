#!/bin/sh
set -eu

git diff --cached --check

if ! git diff --cached --quiet --diff-filter=ACMR -- '*.rs'; then
  cargo fmt --all --check
fi

if ! git diff --cached --quiet --diff-filter=ACMR -- \
  ':(glob)crates/tidebreak-desktop/ui/**/*.ts' \
  ':(glob)crates/tidebreak-desktop/ui/**/*.tsx'; then
  pnpm --dir crates/tidebreak-desktop/ui exec tsc --noEmit
fi
