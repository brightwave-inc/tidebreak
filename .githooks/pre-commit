#!/bin/sh
set -eu

git diff --cached --check

if ! git diff --cached --quiet --diff-filter=ACMR -- '*.rs'; then
  cargo fmt --all --check
fi

if ! git diff --cached --quiet --diff-filter=ACMR -- \
  ':(glob)crates/tidebreak-desktop/ui/**/*.ts' \
  ':(glob)crates/tidebreak-desktop/ui/**/*.tsx' \
  ':(glob)crates/tidebreak-desktop/ui/**/*.css'; then
  pnpm --dir crates/tidebreak-desktop/ui exec biome format src
  pnpm --dir crates/tidebreak-desktop/ui lint
  pnpm --dir crates/tidebreak-desktop/ui exec tsc --noEmit
fi
