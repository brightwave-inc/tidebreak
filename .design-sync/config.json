{
  "projectId": "9f72d042-a029-48e3-b53c-14d4dad2a3be",
  "shape": "package",
  "pkg": "tidebreak-desktop-ui",
  "globalName": "Tidebreak",
  "buildCmd": "pnpm build && cp dist/assets/index-*.css .ds-compiled.css && perl -pi -e 's{/assets/(KaTeX_[A-Za-z0-9]+-[A-Za-z]+)-[A-Za-z0-9_-]+\\.(woff2|woff|ttf)}{node_modules/katex/dist/fonts/$1.$2}g; s{url\\(/fonts/inter/}{url(public/fonts/inter/}g' .ds-compiled.css",
  "srcDir": "src",
  "tsconfig": "tsconfig.json",
  "cssEntry": ".ds-compiled.css",
  "extraEntries": ["sonner"],
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "Dialog": { "cardMode": "single", "viewport": "720x480", "primaryStory": "RenameWorkspace" },
    "AlertDialog": { "cardMode": "single", "viewport": "720x480", "primaryStory": "DiscardChanges" },
    "DropdownMenu": { "cardMode": "single", "viewport": "480x420", "primaryStory": "WorkspaceMenu" },
    "Select": { "cardMode": "single", "viewport": "480x420" },
    "Popover": { "cardMode": "single", "viewport": "480x360", "primaryStory": "ChatActivity" },
    "Tooltip": { "cardMode": "single", "viewport": "480x240" },
    "Toaster": { "cardMode": "single", "viewport": "640x360", "primaryStory": "TurnFinished" },
    "Table": { "cardMode": "column" },
    "ResizablePanelGroup": { "cardMode": "column" },
    "AttentionCard": { "cardMode": "column" },
    "DomainFavicon": { "cardMode": "column" },
    "PanelPrimaryHeader": { "cardMode": "column" },
    "Progress": { "cardMode": "column" },
    "ScrollArea": { "cardMode": "column" },
    "ScrollableContainer": { "cardMode": "column" },
    "Skeleton": { "cardMode": "column" },
    "Tabs": { "cardMode": "column" },
    "ToolActivityGroup": { "cardMode": "column" },
    "ToolIcon": { "cardMode": "column" }
  },
  "componentSrcMap": {
    "AlertDialog": "src/components/ui/alert-dialog.tsx",
    "Badge": "src/components/ui/badge.tsx",
    "Button": "src/components/ui/button.tsx",
    "Card": "src/components/ui/card.tsx",
    "Checkbox": "src/components/ui/checkbox.tsx",
    "Dialog": "src/components/ui/dialog.tsx",
    "DropdownMenu": "src/components/ui/dropdown-menu.tsx",
    "Empty": "src/components/ui/empty.tsx",
    "Input": "src/components/ui/input.tsx",
    "Popover": "src/components/ui/popover.tsx",
    "Progress": "src/components/ui/progress.tsx",
    "RadioGroup": "src/components/ui/radio-group.tsx",
    "ResizablePanelGroup": "src/components/ui/resizable.tsx",
    "ScrollArea": "src/components/ui/scroll-area.tsx",
    "Select": "src/components/ui/select.tsx",
    "Separator": "src/components/ui/separator.tsx",
    "Skeleton": "src/components/ui/skeleton.tsx",
    "Toaster": "src/components/ui/sonner.tsx",
    "Spinner": "src/components/ui/spinner.tsx",
    "Switch": "src/components/ui/switch.tsx",
    "Table": "src/components/ui/table.tsx",
    "Tabs": "src/components/ui/tabs.tsx",
    "Textarea": "src/components/ui/textarea.tsx",
    "Toggle": "src/components/ui/toggle.tsx",
    "Tooltip": "src/components/ui/tooltip.tsx",
    "PanelPrimaryHeader": "src/components/PanelHeader.tsx",
    "SearchInput": "src/components/SearchInput.tsx",
    "OptionListbox": "src/components/OptionListbox.tsx",
    "MessageMarkdown": "src/MessageMarkdown.tsx",
    "ToolCardShell": "src/ToolCardShell.tsx",
    "ThinkingAccordion": "src/ThinkingAccordion.tsx",
    "ClipboardCopyButton": "src/ClipboardCopyButton.tsx",
    "MessageFooter": "src/MessageFooter.tsx",
    "AssistantWorkingIndicator": "src/AssistantWorkingIndicator.tsx",
    "Logomark": "src/Logomark.tsx",
    "ApprovalCard": "src/ApprovalCard.tsx",
    "ToolActivityGroup": "src/ToolActivityGroup.tsx",
    "ToolCommandCard": "src/ToolCallCard.tsx",
    "ToolIcon": "src/ToolIcon.tsx",
    "ToolStatusIcon": "src/ToolStatusIcon.tsx",
    "ChatStatusChip": "src/ChatStatusChip.tsx",
    "AttentionCard": "src/AttentionCard.tsx",
    "InlineCitation": "src/InlineCitation.tsx",
    "DomainFavicon": "src/DomainFavicon.tsx",
    "ScrollableContainer": "src/ScrollableContainer.tsx",
    "TurnFailureNotice": "src/TurnFailureNotice.tsx",
    "ContextUsageIndicator": "src/ContextUsageIndicator.tsx",
    "ChangeSummaryCard": "src/ChangeSummaryCard.tsx",
    "AppCardList": "src/AppCard.tsx",
    "Sidebar": "src/sidebar/primitives.tsx",
    "SidebarButton": "src/sidebar/primitives.tsx",
    "AttentionBadge": "src/code/AttentionBadge.tsx",
    "DiffstatBadge": "src/code/TurnReviewCard.tsx",
    "HarnessPicker": "src/code/HarnessPicker.tsx",
    "DoctorList": "src/code/DoctorList.tsx",
    "CodeToolCard": "src/code/CodeTranscript.tsx",
    "HarnessNotice": "src/code/CodeTranscript.tsx"
  }
}
